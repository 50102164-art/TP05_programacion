@{
    ViewData["Title"] = "Register";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<form id="formRegistro" action="/Home/Registrarse" method="POST">
    <p>Nombre de usuario</p>
    <input type="text" name="UsuarioNuevo.NombreUsuarios" id="NombreUsuarios">

    <p>Contraseña</p>
    <input type="password" name="UsuarioNuevo.Contraseña" id="Contraseña">

    <p>Nombre</p>
    <input type="text" name="UsuarioNuevo.Nombre" id="Nombre">

    <p>Apellido</p>
    <input type="text" name="UsuarioNuevo.Apellido" id="Apellido"></br>

    </br><select name="UsuarioNuevo.TipoUsuario" id="TipoUsuario">
        <option value="Alumno">Alumno</option>
        <option value="Docente">Docente</option>
        <option value="Coordinador">Coordinador</option>
        <option value="Padre">Padre</option>
    </select></br>

    <!-- agregar campos de domicilio -->
    <p>Calle</p>
    <input type="text" name="DomicilioNuevo.Calle" id="Calle">

    <p>Numero</p>
    <input type="number" name="DomicilioNuevo.Numero" id="Numero">

    <p>Departamento</p>
    <input type="text" name="DomicilioNuevo.Departamento" id="Departamento">

    </br><button type="button" onclick="site.VerificarDatosUsuario()">Submit</button>

</form>